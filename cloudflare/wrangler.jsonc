// NemoFleet memory on Cloudflare. IDs only, no secrets (auth comes from CLOUDFLARE_API_TOKEN in .env).
//   npx wrangler d1 migrations apply nemofleet-memory --remote -c cloudflare/wrangler.jsonc
{
  "name": "nemofleet-memory",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "MEMORY",                       // precedents, runs, call index, perception, Night Shift stages
      "database_name": "nemofleet-memory",
      "database_id": "eb9d266f-5753-45da-9378-5797b5cf1fdc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "RUNS", "bucket_name": "nemofleet-runs" }  // calls.jsonl, summaries, raw Cosmos output, Night Shift artifacts
  ],
  "kv_namespaces": [
    { "binding": "TAGS", "id": "51e4053c22464b5dbe31b0069ed10281" }  // fading hazard tags (expirationTtl)
  ]
}
